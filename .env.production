# .env.production
# ============================================================
# WICHTIG: Diese Datei enthält sensible Daten!
# NIE ins Git committen! (.gitignore prüfen!)
# ============================================================

# ============================================================
# Docker Image Configuration
# ============================================================
VERSION=v0.7.4
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=germanlion67

# ============================================================
# PocketBase Admin (Erstinitialisierung)
# ============================================================
PB_ADMIN_EMAIL=admin@germanlion67.de
PB_ADMIN_PASSWORD=IhrSicheresPasswort123!

# ============================================================
# Internal Ports (Docker network only)
# ============================================================
PB_PORT=8080
WEB_PORT=8081

# ============================================================
# Application URL
# WICHTIG: Muss vom BROWSER des Users erreichbar sein!
# Das ist die öffentliche URL über Nginx Proxy Manager.
# NICHT die Docker-interne URL (http://pocketbase:8080)!
# ============================================================
POCKETBASE_URL=https://api.germanlion67.de

# ============================================================
# CORS-Konfiguration
# NIEMALS * in Produktion!
# ============================================================
CORS_ALLOWED_ORIGINS=https://lager.germanlion67.de

# ============================================================
# Dev-Modus — In Produktion IMMER 0
# ============================================================
PB_DEV_MODE=0

# ============================================================
# Test-User — In Produktion DEAKTIVIERT
# ============================================================
PB_TEST_USER_ENABLED=0
PB_TEST_USER_EMAIL=user@lager.app
PB_TEST_USER_PASSWORD=changeme123
PB_FORCE_SUPERUSER_UPSERT=0

# ============================================================
# Backup-Konfiguration
# ============================================================
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=30
TZ=Europe/Berlin

# ============================================================
# Backup-Benachrichtigung (optional)
# ============================================================
BACKUP_NOTIFY=none

# ── E-Mail (SMTP) ──
# Nur relevant wenn BACKUP_NOTIFY=email
# BACKUP_SMTP_HOST=smtp.example.com
# BACKUP_SMTP_PORT=587
# BACKUP_SMTP_USER=backup@germanlion67.de
# BACKUP_SMTP_PASS=
# BACKUP_SMTP_FROM=backup@germanlion67.de
# BACKUP_SMTP_TO=admin@germanlion67.de

# ── Webhook ──
# Nur relevant wenn BACKUP_NOTIFY=webhook
BACKUP_WEBHOOK_URL=