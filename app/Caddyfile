# Caddyfile — REFERENZ-DOKUMENTATION
#
# ⚠️  DIESE DATEI WIRD NICHT VERWENDET.
# Das produktive Caddyfile wird zur Laufzeit durch docker-entrypoint.sh
# generiert (/etc/caddy/Caddyfile). Änderungen hier haben keine Wirkung.
#
# Diese Datei dient als lesbare Referenz für die Caddy-Konfiguration.
# Alle Änderungen müssen in docker-entrypoint.sh vorgenommen werden.


:8081 {
	root * /srv
	encode gzip

	# Security Headers
	header {
		# Verhindert MIME-Type Sniffing
		X-Content-Type-Options "nosniff"

		# Schützt vor Clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Aktiviert XSS-Filter in älteren Browsern
		X-XSS-Protection "1; mode=block"

		# Kontrolliert welche Referrer-Informationen gesendet werden
		Referrer-Policy "strict-origin-when-cross-origin"

		# HTTP Strict Transport Security — erzwingt HTTPS für 1 Jahr
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Content Security Policy
		# Flutter Web benötigt 'unsafe-inline' für Styles und 'wasm-unsafe-eval' für Dart/WASM
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: {$POCKETBASE_URL}; font-src 'self' data:; connect-src 'self' https: ws: wss: {$POCKETBASE_URL}; frame-ancestors 'self';"

		# Permissions Policy
		Permissions-Policy "geolocation=(), microphone=(), camera=(self)"

		# Deaktiviert Browser-Features die nicht benötigt werden
		X-Permitted-Cross-Domain-Policies "none"

		# Cross-Origin Isolation für SharedArrayBuffer / Skwasm (LH-B-001)
		# ⚠️ Testen: Kann externe Ressourcen (Fonts, PocketBase) blockieren
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}

	# Cache-Control: index.html nie cachen
	header /index.html Cache-Control "no-cache, no-store, must-revalidate"
	header /index.html Pragma "no-cache"
	header /index.html Expires "0"

	# Cache-Control: config.js nie cachen (dynamisch generiert, enthält POCKETBASE_URL)
	header /config.js Cache-Control "no-cache, no-store, must-revalidate"
	header /config.js Pragma "no-cache"
	header /config.js Expires "0"

	# Cache-Control: manifest.json kurz cachen (ändert sich selten)
	header /manifest.json Cache-Control "public, max-age=86400"

	# Cache-Control: statische Assets lange cachen
	# Flutter verwendet Content-Hashes im Dateinamen → immutable sicher
	# config.js und index.html sind explizit ausgenommen (siehe oben)
	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg \
		     *.woff *.woff2 *.ttf *.eot *.wasm
		not path /config.js
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# SPA-Routing: unbekannte Pfade → /index.html
	try_files {path} /index.html

	file_server
}