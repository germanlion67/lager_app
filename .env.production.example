# ============================================================
# Lager App — Production Environment Variables
#
# WICHTIG: Diese Datei enthält sensible Daten!
# - NIE ins Git committen!
# - Sichere Passwörter verwenden!
# - In Production: Secrets Management nutzen
# ============================================================

# ============================================================
# Docker Image Configuration
# Verwende vorgebaute Images von GitHub Container Registry
# Empfohlen: Exakte Version wie v1.2.0 statt "latest"
# ============================================================
VERSION=v1.0.0
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your-github-username

# ============================================================
# PocketBase Admin Account (Erstinitialisierung)
# Wird beim ersten Start automatisch erstellt
# ⚠️ Sicheres Passwort verwenden (min. 12 Zeichen, Sonderzeichen)!
# ============================================================
PB_ADMIN_EMAIL=admin@your-domain.com
PB_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!

# ============================================================
# Internal Ports (Docker network only)
# Diese Ports werden NICHT nach außen exponiert
# ============================================================
PB_PORT=8080
WEB_PORT=8081

# ============================================================
# Application URL
# WICHTIG: Diese URL muss vom BROWSER erreichbar sein!
# Das ist die öffentliche URL über Nginx Proxy Manager.
# NICHT die Docker-interne URL (http://pocketbase:8080)!
#
# Beispiele:
#   - https://api.example.com     (Subdomain-Routing, empfohlen)
#   - https://example.com/api     (Pfad-Routing, nicht empfohlen)
# ============================================================
POCKETBASE_URL=https://api.your-domain.com

# ============================================================
# CORS-Konfiguration
# WICHTIG: In Produktion MUSS diese Variable gesetzt sein!
# Komma-getrennte Liste erlaubter Origins (keine Leerzeichen!)
# KEIN Trailing-Slash! NIEMALS * in Produktion!
#
# Muss die Domain(s) enthalten, von denen das Web-Frontend
# geladen wird (NICHT die API-Domain).
#
# Beispiele:
#   CORS_ALLOWED_ORIGINS=https://lager.example.com
#   CORS_ALLOWED_ORIGINS=https://lager.example.com,https://admin.example.com
# ============================================================
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ============================================================
# Dev-Modus — In Produktion IMMER 0
# 0 = Produktions-Regeln + Login erforderlich
# ============================================================
PB_DEV_MODE=0

# ============================================================
# Test-User — In Produktion DEAKTIVIEREN
# ⚠️ PB_TEST_USER_ENABLED=0 setzt voraus dass kein Test-User
#    existiert oder bereits manuell deaktiviert wurde.
# ============================================================
PB_TEST_USER_ENABLED=0
PB_TEST_USER_EMAIL=user@your-domain.com
PB_TEST_USER_PASSWORD=CHANGE_THIS_TOO!
PB_FORCE_SUPERUSER_UPSERT=0

# ============================================================
# Backup-Konfiguration
# ============================================================
BACKUP_ENABLED=true

# Cron-Schedule (Standard: täglich um 3:00 Uhr)
# Format: Minute Stunde Tag Monat Wochentag
BACKUP_CRON=0 3 * * *

# Anzahl Tage, die Backups aufbewahrt werden
# Empfehlung Produktion: 30 Tage
BACKUP_KEEP_DAYS=30

# Zeitzone für Cron und Zeitstempel
TZ=Europe/Berlin

# ============================================================
# Backup-Benachrichtigung (optional)
# ============================================================

# Benachrichtigungstyp: none | email | webhook
BACKUP_NOTIFY=none

# ── E-Mail (SMTP) ──
# Nur relevant wenn BACKUP_NOTIFY=email
# BACKUP_SMTP_HOST=smtp.example.com
# BACKUP_SMTP_PORT=587
# BACKUP_SMTP_USER=backup@your-domain.com
# BACKUP_SMTP_PASS=
# BACKUP_SMTP_FROM=backup@your-domain.com
# BACKUP_SMTP_TO=admin@your-domain.com

# ── Webhook ──
# Nur relevant wenn BACKUP_NOTIFY=webhook
# Kompatibel mit Slack, Discord, Gotify, Ntfy, etc.
# BACKUP_WEBHOOK_URL=https://hooks.example.com/your-webhook-url
BACKUP_WEBHOOK_URL=